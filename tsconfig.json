{
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "extensions/**/*.ts"],
  "exclude": ["apps/desktop/dist", "extensions/*/dist"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#app/*": ["./apps/desktop/src/*"],
      "@sheet/platform": ["./packages/platform/src/runtime.ts"],
      "@sheet/platform/*": ["./packages/platform/src/*"],
      "@sheet/shell/lib/*": ["./packages/shell/src/lib/*.ts"],
      "@sheet/shell/*": ["./packages/shell/src/components/*.tsx"],
      "@sheet/db": ["./packages/db/src/index.ts"],
      "@sheet/db/*": ["./packages/db/src/*"],
      "@sheet/canvas": ["./packages/canvas/src/index.ts"],
      "@sheet/canvas/*": ["./packages/canvas/src/*"],
      "@sheet/realtime/*": ["./packages/realtime/src/*"],
      "@sheet/rpc": ["./packages/rpc/src/router.ts"],
      "@sheet/rpc/*": ["./packages/rpc/src/*"],
      "@sheet/editor/lib/canvas-capture": [
        "./packages/editor/src/lib/canvas-capture.tsx"
      ],
      "@sheet/editor/lib/*": ["./packages/editor/src/lib/*.ts"],
      "@sheet/editor/*": ["./packages/editor/src/components/*.tsx"],
      "@sheet/ui/utils": ["./packages/ui/src/lib/utils.ts"],
      "@sheet/ui/icons": ["./packages/ui/src/icons/index.tsx"],
      "@sheet/ui/hooks/*": ["./packages/ui/src/hooks/*.ts"],
      "@sheet/ui/*": ["./packages/ui/src/components/*.tsx"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
