{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheet",
  "version": "1.1.0",
  "identifier": "design.sheet.desktop",
  "build": {
    "beforeDevCommand": "bunx vite dev --port 1421 --strictPort --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "bun run build:app && bun run build:server",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:*",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' http://127.0.0.1:* blob: data:",
        "font-src": "'self' http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:*",
        "script-src": "'self' http://127.0.0.1:*"
      },
      "capabilities": ["default", "window-drag"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENDQ5MkU3QkJCREZFOEEKUldTSy9yMjc1NUpFdmF2ZUFISlBtOEszRUNvUmVzTTBvaUYraUt6K3NTemRKSCsvN2Q1MFVBd1oK",
      "endpoints": [
        "https://github.com/DeepanshuMishraa/sheet/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist/app/**/*", "binaries/*"]
  }
}
