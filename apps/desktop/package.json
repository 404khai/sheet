{
  "name": "@sheet/desktop",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite dev --mode web --strictPort --host 127.0.0.1",
    "build:app": "vite build",
    "build:server": "bun run ../../scripts/build-server.ts",
    "build": "tauri build",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@sheet/canvas": "workspace:*",
    "@sheet/editor": "workspace:*",
    "@sheet/platform": "workspace:*",
    "@sheet/rpc": "workspace:*",
    "@sheet/shell": "workspace:*",
    "@sheet/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-router": "latest",
    "@tanstack/router-plugin": "^1.168.22",
    "motion": "^12.42.2",
    "nuqs": "^2.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/router-cli": "^1.167.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "catalog:",
    "vite": "^8.1.5"
  }
}
